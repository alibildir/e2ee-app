# syntax=docker/dockerfile:1.6
# ─────────────────────────────────────────────────────────────────────────────
# OpenE2EE Web Dashboard — nginx:alpine static server
# Pre-built Flutter web assets are copied into the image.
#
# Build:
#   flutter build web --target=lib/web/main.dart --release
#   docker build -f Dockerfile.web -t registry.izinonaysistemi.com/opene2ee/web:1.0.0 .
# ─────────────────────────────────────────────────────────────────────────────

FROM nginx:alpine

# Remove default nginx content
RUN rm -rf /usr/share/nginx/html/*

# Copy Flutter web build output
COPY build/web/ /usr/share/nginx/html/

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://localhost/ || exit 1
